# Supersocks Media Scraper local template
# Copy to .env. Do not commit real .env, profiles, cookies, tokens, or media.

# Optional X/Twitter via upstream twitter-cli (not a package extra).
# Set BOTH before reading x.com / twitter.com URLs.
# Export from a manual Cookie-Editor dump only. Never auto-read browser cookies.
# TWITTER_AUTH_TOKEN=
# TWITTER_CT0=

# CloakBrowser profiles for Reddit / Instagram / Facebook (browser extra).
# Prefer isolated per-platform profiles:
# MEDIA_BROWSER_PROFILES_ROOT=/path/to/media-browser-profiles
#   → {root}/reddit, {root}/instagram, {root}/facebook
# Legacy single-dir fallback:
# MEDIA_BROWSER_PROFILE_DIR=
# BROWSER_PROFILE_DIR=

# Headed warm-up (macOS/Windows native GUI; Linux needs existing DISPLAY/Xvfb):
# supersocks-media-scraper --warmup reddit --create-profile --warmup-seconds 120
# CLOAK_HEADLESS=0
# DISPLAY=:99

# Docker Compose guided noVNC warm-up (allowlisted platform only).
# WARMUP_PLATFORM=instagram
# WARMUP_SECONDS=600
# Open http://127.0.0.1:6080/vnc.html?autoconnect=1&resize=scale
# SECURITY: noVNC has no password — Compose binds loopback only; never expose publicly.
# Remote host: ssh -L 6080:127.0.0.1:6080 user@docker-host

# Quiet noisy Chromium/Cloak font warnings.
CLOAKBROWSER_SUPPRESS_FONT_WARNING=1
